{
  "name": "jpush-harmony-rn-plugin",
  "description": "React Native JPush component for HarmonyOS",
  "homepage": "https://github.com/jpush/jpush-harmony-rn-plugin",
  "main": "index.ts",
  "license": "ISC",
  "author": "terry",
  "version": "1.4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jpush/jpush-harmony-rn-plugin"
  },
  "keywords": [
    "react-native",
    "JPush",
    "harmony"
  ],
  "peerDependencies": {
    "react-native": ">= 0.72.5"
  },
  "files": [
    "index.ts",
    "src/",
    "harmony/jpush_harmony/",
    "tsconfig.json",
    "documents/"
  ],
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build": "tsc --noEmit"
  },
  "harmony": {
    "alias": "jpush-harmony-rn-plugin",
    "codegenConfig": {
      "specPaths": [
        "./src"
      ]
    }
  },
  "private": false,
  "devDependencies": {
    "typescript": "^5.0.4"
  }
}
